# GEMINI_API_KEY: Required for Gemini AI API calls (if added later).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SECRET_KEY: Secret key for signing Flask/Express sessions (generate a strong random string in production)
SECRET_KEY=

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional initial owner credentials for seed.py (otherwise claim via /admin setup)
ADMIN_EMAIL="owner@sturex.store"
ADMIN_PASSWORD=
